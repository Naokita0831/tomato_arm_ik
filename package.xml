<?xml version="1.0"?>
<package format="3">
  <name>tomato_arm_ik</name>
  <version>0.1.0</version>
  <description>ROS 2 package for Crane+ IK joy control and Dynamixel AX position control.</description>
  <maintainer email="naokita0831g@gmail.com">Naoki Kitamura</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>joy</depend>
  <depend>xacro</depend>
  <depend>dynamixel_sdk</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
